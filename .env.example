# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: Public app URL / Cloud Run service URL.
APP_URL=""

# TELEGRAM_BOT_TOKEN: REQUIRED in production. Never put this in frontend code or localStorage.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: REQUIRED in production. Use one or more numeric IDs separated by commas.
TELEGRAM_CHAT_ID=""

# SESSION_SECRET: Strong random secret for signing admin session cookies.
# If omitted, the server generates an ephemeral random secret (sessions reset on restart).
SESSION_SECRET=""

# ADMIN_PASSWORD_HASH: Preferred production credential (scrypt:<salt>:<hash>).
ADMIN_PASSWORD_HASH=""

# ADMIN_INITIAL_PASSWORD: REQUIRED for first-run admin initialization when no hash exists.
# Use a strong password of at least 8 characters, then prefer ADMIN_PASSWORD_HASH afterwards.
ADMIN_INITIAL_PASSWORD=""

# GOOGLE_CLIENT_ID: Optional Google OAuth Client ID for sign-in.
GOOGLE_CLIENT_ID=""
